NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check 용 reCAPTCHA v3 사이트 키 (공개 키). NEXT_PUBLIC_ 접두어 사용.
# 클라이언트 번들에 인라인되며 Firebase SDK가 자동으로 App Check 토큰을 첨부한다.
# 부재 시 App Check는 비활성(skip)이고 기존 Firebase Auth 흐름은 그대로 동작한다.
# 점진 도입: 등록 → 며칠 모니터링 → enforcement ON 순서.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# 관리자 페이지(/admin, /admin/*) basic auth용. 서버 전용. NEXT_PUBLIC_ 접두어 금지.
# 페이지 1차 잠금이며, /api/admin/* 인증과는 완전히 분리되어 있다.
# (관리자 API는 Firebase ID token + custom claim admin=true 로 검증한다.)
# 둘 중 하나라도 비어 있으면 admin 페이지는 503(fail-closed)로 응답한다.
ADMIN_PAGE_USER=
ADMIN_PAGE_PASSWORD=

# rate limit helper(src/lib/server/rate-limit.ts)가 IP/email/token 식별자를
# HMAC-SHA256으로 해시할 때 쓰는 비밀키. 서버 전용. NEXT_PUBLIC_ 접두어 금지.
# 16자 이상 권장. 부재 시 helper가 명시 throw하고 OAuth route는 500으로 응답한다.
RATE_LIMIT_HMAC_SECRET=

# 카카오 로그인. 서버 전용. Kakao Developers의 REST API 키와 redirect URI를 넣는다.
# KAKAO_CLIENT_SECRET은 카카오 콘솔에서 client secret을 활성화한 경우에만 필요하다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 네이버 로그인. 서버 전용. Naver Developers의 Client ID/Secret과 callback URL을 넣는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/api/auth/naver/callback

# 체육관 데이터 백엔드. "db"(기본) 또는 "mock"(테스트/시연용).
# 옛 변수 NEXT_PUBLIC_GYM_DATA_SOURCE는 폐기됨. 그 값이 살아 있으면 명시적으로 throw한다.
NEXT_PUBLIC_GYM_DATA_BACKEND=db

# 즐겨찾기 데이터 백엔드. "db"(기본) 또는 "local"(브라우저 localStorage).
# 옛 변수 NEXT_PUBLIC_FAVORITE_DATA_SOURCE는 폐기됨. 그 값이 살아 있으면 명시적으로 throw한다.
NEXT_PUBLIC_FAVORITE_DATA_BACKEND=db

# 예약 데이터 백엔드. "db"(기본) 또는 "mock"(테스트/시연용 in-memory).
# 옛 변수 NEXT_PUBLIC_RESERVATION_DATA_SOURCE는 폐기됨. 그 값이 살아 있으면 명시적으로 throw한다.
NEXT_PUBLIC_RESERVATION_DATA_BACKEND=db

# --- Postgres (Supabase 운영 / 로컬 Docker dev) ---------------------------------
# DATABASE_URL은 .env가 아니라 .env.local에 둔다. (Prisma CLI가 .env를 자동 로드해서
# 다른 환경의 DATABASE_URL을 덮어쓰는 문제를 피하기 위함)
#
# 로컬 dev (.env.local) 예시:
#   DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/gym_reservation_dev?schema=public
#   DIRECT_URL=postgresql://postgres:PASSWORD@localhost:5432/gym_reservation_dev?schema=public
#
# 테스트 (.env.test.local) 예시:
#   DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/gym_reservation_test?schema=public
#   DIRECT_URL=postgresql://postgres:PASSWORD@localhost:5432/gym_reservation_test?schema=public
#
# Vercel(운영) 환경변수 매핑:
#   DATABASE_URL ← Supabase가 주입한 POSTGRES_PRISMA_URL  (pooled, 앱 트래픽용)
#   DIRECT_URL   ← Supabase가 주입한 POSTGRES_URL_NON_POOLING (direct, migration용)
#
# Prisma 명령은 npm run db:seed / db:migrate:dev / db:migrate:deploy 처럼
# dotenv-cli로 명시적으로 .env.local을 inject하는 스크립트를 통해 실행한다.
#
# 운영(Supabase) DB에 migrate/seed를 적용할 때:
#   1) PowerShell에서 운영 URL을 임시 주입 (작은따옴표 필수):
#        $env:DATABASE_URL = '여기에 POSTGRES_PRISMA_URL 값'
#        $env:DIRECT_URL   = '여기에 POSTGRES_URL_NON_POOLING 값'
#   2) 운영 전용 스크립트 실행:
#        npm run db:migrate:prod   # 운영 DB에 init/추가 migration 적용
#        npm run db:seed:prod      # 운영 DB에 gym 시드
#   3) 끝나면 변수 비우기:
#        $env:DATABASE_URL = $null
#        $env:DIRECT_URL   = $null
#
# 두 스크립트는 PRISMA_ENV=production 마커를 주입해 .env.local override를 건너뛴다
# (prisma.config.ts의 분기 참고). 비밀값은 코드/로그/채팅에 절대 노출하지 않는다.

# --- Docker Compose (로컬 Postgres 기동용) --------------------------------------
# docker compose --env-file .env.local up -d 로 실행할 때 참조됨.
# POSTGRES_PASSWORD는 필수, 나머지는 기본값 사용 가능.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gym_reservation_dev
POSTGRES_PORT=5432

# Firebase Admin SDK 자격증명. 서버 전용. NEXT_PUBLIC_ 접두어 금지.
# 옵션 ㄱ: 서비스 계정 JSON 파일 경로 (권장)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json
# 옵션 ㄴ: JSON에서 3개 값만 직접 등록 (PRIVATE_KEY는 큰따옴표 + \n 그대로)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
