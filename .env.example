NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 데이터 소스 선택. 명시하지 않으면 모두 mysql이 기본값.
# mock/firestore/local은 옵션 — 자세한 근거는 docs/data-source-status.md 참고.
NEXT_PUBLIC_GYM_DATA_SOURCE=mysql

# 즐겨찾기 저장소. mysql(기본) 또는 local(브라우저 localStorage).
NEXT_PUBLIC_FAVORITE_DATA_SOURCE=mysql

# 예약 저장소. mysql(기본) 또는 firestore(legacy 어댑터).
NEXT_PUBLIC_RESERVATION_DATA_SOURCE=mysql

# MySQL DATABASE_URL은 .env가 아니라 .env.local에 두세요.
# 이유: Prisma CLI가 .env를 자동 로드하면서 process.env를 덮어써서
#      테스트/스테이징 등 다른 환경의 DATABASE_URL을 inject할 수 없게 됨.
# .env.local 예시 (gitignore됨, 실제로는 이 파일에 적습니다):
#   DATABASE_URL=mysql://user:password@localhost:3306/gym_reservation
# 테스트 DB는 .env.test.local에 별도 정의:
#   DATABASE_URL=mysql://user:password@localhost:3306/gym_reservation_test
# Prisma 명령은 npm run db:seed / db:migrate:dev / db:migrate:deploy 처럼
# dotenv-cli로 명시적으로 .env.local을 inject하는 스크립트를 통해 실행하세요.

# Firebase Admin SDK 자격증명. 서버 전용. NEXT_PUBLIC_ 접두어 금지.
# 옵션 ㄱ: 서비스 계정 JSON 파일 경로 (권장)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json
# 옵션 ㄴ: JSON에서 3개 값만 직접 등록 (PRIVATE_KEY는 큰따옴표 + \n 그대로)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
