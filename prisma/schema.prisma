// Prisma 스키마 — Postgres(Supabase) 기반 체육관, 예약, 즐겨찾기, 사용자 프로필 저장소.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 앱 트래픽용 pooled 연결 (Vercel/Supabase 환경에서 POSTGRES_PRISMA_URL 매핑)
  url       = env("DATABASE_URL")
  // migration / admin tooling용 direct 연결 (POSTGRES_URL_NON_POOLING 매핑)
  directUrl = env("DIRECT_URL")
}

// 가변 길이 배열/객체 필드는 JSON 컬럼으로 둔다.
// sports만 검색/필터에 자주 쓰이므로 별도 테이블로 정규화한다.
model Gym {
  id               String            @id @db.VarChar(64)
  name             String            @db.VarChar(200)
  region           String            @db.VarChar(100)
  address          String            @db.VarChar(300)
  officialUrl      String            @map("official_url") @db.VarChar(500)
  openHours        String            @map("open_hours") @db.VarChar(100)
  basePrice        Int               @map("base_price")
  description      String            @db.Text
  // 위/경도. 사용자 현재 위치 기반 거리 계산의 SSOT. 좌표 없는 체육관은 등록할 수 없다.
  latitude         Float
  longitude        Float
  sportPrices      Json              @map("sport_prices")
  facilities       Json
  availableTimes   Json              @map("available_times")
  closedDays       Json              @map("closed_days")
  isActive         Boolean           @default(true) @map("is_active")
  sports           GymSport[]
  favorites        Favorite[]
  reservations     Reservation[]
  reservationSlots ReservationSlot[]

  @@map("gyms")
}

model GymSport {
  gymId String @map("gym_id") @db.VarChar(64)
  sport String @db.VarChar(20)
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, sport])
  @@map("gym_sports")
}

// userId는 Firebase Auth uid. 복합 PK로 멱등성 확보.
model Favorite {
  userId    String   @map("user_id") @db.VarChar(64)
  gymId     String   @map("gym_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([userId, gymId])
  @@index([userId], map: "idx_favorites_user")
  @@map("favorites")
}

// Firebase Auth uid에 연결되는 앱 전용 프로필/설정.
// provider는 표시/통계 전용. server에서 ID token의 sign_in_provider와 uid prefix로
// 산출해 저장한다. 클라이언트가 직접 보낸 값은 신뢰하지 않는다.
// MVP에서는 nullable 유지. 신규 가입부터 채워 충분히 검증된 뒤 not null로 전환.
model UserProfile {
  userId                          String   @id @map("user_id") @db.VarChar(64)
  nickname                        String?  @unique @db.VarChar(30)
  provider                        String?  @db.VarChar(16)
  name                            String?  @db.VarChar(30)
  phone                           String?  @db.VarChar(20)
  birthDate                       String?  @map("birth_date") @db.VarChar(10)
  address                         String?  @db.VarChar(200)
  preferredRegion                 String?  @map("preferred_region") @db.VarChar(100)
  preferredSports                 Json     @map("preferred_sports")
  reservationNotificationsEnabled Boolean  @default(true) @map("reservation_notifications_enabled")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt                       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("user_profiles")
}

// 예약 본체. status: reserved | cancelled | used.
// activeKey는 (userId, gymId, sport, date, time) 인코딩으로 만들어진 중복 방지 키.
model Reservation {
  id        String           @id @db.VarChar(64)
  userId    String           @map("user_id") @db.VarChar(64)
  gymId     String           @map("gym_id") @db.VarChar(64)
  sport     String           @db.VarChar(20)
  date      String           @db.VarChar(10)
  time      String           @db.VarChar(5)
  price     Int
  status    String           @db.VarChar(16)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  activeKey String           @map("active_key") @db.VarChar(255)
  gym       Gym              @relation(fields: [gymId], references: [id])
  lock      ReservationLock?

  @@index([userId, createdAt(sort: Desc)], map: "idx_res_user_created")
  @@map("reservations")
}

// 같은 사용자 같은 슬롯의 활성 예약을 단 1건으로 강제하는 락.
// PK가 activeKey라 INSERT 시 P2002로 중복 감지.
model ReservationLock {
  activeKey     String      @id @map("active_key") @db.VarChar(255)
  reservationId String      @unique @map("reservation_id") @db.VarChar(64)
  status        String      @db.VarChar(16)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_locks")
}

model ReservationSlot {
  gymId         String   @map("gym_id") @db.VarChar(64)
  sport         String   @db.VarChar(20)
  date          String   @db.VarChar(10)
  time          String   @db.VarChar(5)
  capacity      Int
  reservedCount Int      @default(0) @map("reserved_count")
  isClosed      Boolean  @default(false) @map("is_closed")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, sport, date, time])
  @@index([gymId, date], map: "idx_res_slots_gym_date")
  @@map("reservation_slots")
}

// 회원 탈퇴 시 익명으로 수집하는 사유 통계. uid는 보관하지 않는다 (탈퇴 즉시 식별자 폐기).
// detail은 자유 텍스트(최대 300자 클라이언트 제한, 컬럼은 여유 둠).
model WithdrawalReason {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(32)
  detail    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([createdAt], map: "idx_withdrawal_created")
  @@map("withdrawal_reasons")
}

// 외부 OAuth provider(카카오/네이버) authorize 요청을 추적하는 단기 store.
// /start에서 state를 발급해 저장하고, /callback에서 1회 소비한다.
// status: "pending" -> "consumed". 만료된 행은 진입 시 opportunistic cleanup.
// 익명 흐름 제거 후 anonUid 컬럼은 의미가 사라져 제거됨.
model OAuthAttempt {
  attemptId String   @id @map("attempt_id") @db.VarChar(64)
  provider  String   @db.VarChar(16)
  state     String   @db.VarChar(128)
  status    String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)

  @@index([expiresAt], map: "idx_oauth_attempt_expires")
  @@map("oauth_attempts")
}

// 범용 rate limit bucket. scope + identifierHash + windowStart 복합 PK로 같은 윈도우의
// 같은 식별자 요청을 누적 카운트한다. identifierHash는 helper(src/lib/server/rate-limit.ts)가
// HMAC-SHA256(RATE_LIMIT_HMAC_SECRET, raw)로 산출한 hex 문자열이다. 원문 IP/email/token은
// 절대 저장하지 않는다. 만료된 행은 helper 호출 시 opportunistic cleanup.
model RateLimitBucket {
  scope          String   @db.VarChar(64)
  identifierHash String   @map("identifier_hash") @db.VarChar(64)
  windowStart    DateTime @map("window_start") @db.Timestamp(3)
  count          Int      @default(0)
  expiresAt      DateTime @map("expires_at") @db.Timestamp(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@id([scope, identifierHash, windowStart])
  @@index([expiresAt], map: "idx_rate_limit_expires")
  @@map("rate_limit_buckets")
}

// /callback 이후 클라이언트 handover 흐름을 control하는 1회용 ticket.
// 상태 머신: "pending" -> "token_issued" -> "signed_in" -> "finalized".
//   pending      : callback 완료, customToken 미발급
//   token_issued : /token이 nonce 검증 후 customToken 발급
//   signed_in    : 클라이언트가 targetUid ID token으로 /finalize 도달
//   finalized    : /finalize 처리 완료(profile sync 등)
// handoverNonce는 HttpOnly cookie와 1:1 매칭되는 bearer 보강 값이다.
// 익명 흐름 제거 후 anonUid/migration이 사라져 finalize는 단순화됨(outcome 없음).
// profilePayload는 callback이 받아온 provider profile snapshot이며,
// finalize에서 admin.updateUser 호출에 사용된다. 토큰류는 저장하지 않는다.
// finalizeAttemptCount/lastFinalizeError는 운영/디버깅용.
// 만료된 행은 진입 시 opportunistic cleanup.
model AuthHandoverTicket {
  ticketId             String   @id @map("ticket_id") @db.VarChar(64)
  targetUid            String   @map("target_uid") @db.VarChar(64)
  provider             String   @db.VarChar(16)
  handoverNonce        String   @map("handover_nonce") @db.VarChar(128)
  profilePayload       Json?    @map("profile_payload")
  status               String   @db.VarChar(16)
  finalizeAttemptCount Int      @default(0) @map("finalize_attempt_count")
  lastFinalizeError    String?  @map("last_finalize_error") @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  expiresAt            DateTime @map("expires_at") @db.Timestamp(3)

  @@index([expiresAt], map: "idx_auth_ticket_expires")
  @@map("auth_handover_tickets")
}

// 관리자 운영 이력(audit). 누가(adminUid) 어떤 액션(action)을 어떤 대상(targetType/targetId)에
// 수행했는지 기록한다. summary/metadata에는 PII 원문(email/이름 등)을 담지 않고
// 식별자(uid)·상태값·건수 수준만 남긴다. id는 Prisma cuid로 생성한다.
// best-effort 기록이며, audit insert 실패가 본 mutation을 깨지 않도록 호출 측에서 격리한다.
model AuditLog {
  id         String   @id @default(cuid())
  adminUid   String   @map("admin_uid") @db.VarChar(64)
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(128)
  summary    String   @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@index([targetType, targetId], map: "idx_audit_target")
  @@map("audit_logs")
}

// 관리자가 특정 고객(userId = Firebase uid)에 남기는 운영 메모.
// adminUid는 작성한 관리자 uid. body는 자유 텍스트(컬럼 최대 1000자).
model UserNote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.VarChar(64)
  adminUid  String   @map("admin_uid") @db.VarChar(64)
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_notes_user_created")
  @@map("user_notes")
}

// 운영 배너. 관리자가 admin 화면에서 업로드/교체하며 홈에 노출한다.
// 이미지는 Supabase Storage(banners 버킷)에 두고 DB엔 imagePath(uuid.ext)만 저장한다.
// public URL은 imagePath에서 결정적으로 파생한다(SSOT=imagePath).
// 노출 조건: isActive && (startsAt..endsAt 범위, null이면 상시). sortOrder 오름차순.
model Banner {
  id        String    @id @default(cuid())
  imagePath String    @map("image_path") @db.VarChar(256)
  linkUrl   String?   @map("link_url") @db.VarChar(2000)
  title     String?   @db.VarChar(200)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at") @db.Timestamp(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@index([isActive, sortOrder], map: "idx_banner_active_sort")
  @@map("banners")
}

// 공지사항 조회수 카운터. 공지 본문/메타는 코드(src/lib/notices.ts)가 SSOT이고,
// 조회수만 동적이라 여기서 noticeId별 누적 카운트만 보관한다(상세 진입 시 +1).
// 행이 없으면 0으로 간주하고 첫 조회 시 upsert로 생성한다.
// 카운트 갱신 실패는 best-effort라 호출 측에서 격리해 페이지 렌더를 막지 않는다.
model NoticeView {
  noticeId  String   @id @map("notice_id") @db.VarChar(64)
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("notice_views")
}
