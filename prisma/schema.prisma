// Prisma 스키마 — MySQL 기반 체육관, 예약, 즐겨찾기, 사용자 프로필 저장소.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 가변 길이 배열/객체 필드는 JSON 컬럼으로 둔다.
// sports만 검색/필터에 자주 쓰이므로 별도 테이블로 정규화한다.
model Gym {
  id               String            @id @db.VarChar(64)
  name             String            @db.VarChar(200)
  region           String            @db.VarChar(100)
  address          String            @db.VarChar(300)
  officialUrl      String            @map("official_url") @db.VarChar(500)
  openHours        String            @map("open_hours") @db.VarChar(100)
  basePrice        Int               @map("base_price")
  description      String            @db.Text
  distanceKm       Decimal           @map("distance_km") @db.Decimal(5, 2)
  sportPrices      Json              @map("sport_prices")
  facilities       Json
  availableTimes   Json              @map("available_times")
  closedDays       Json              @map("closed_days")
  isActive         Boolean           @default(true) @map("is_active")
  sports           GymSport[]
  favorites        Favorite[]
  reservations     Reservation[]
  reservationSlots ReservationSlot[]

  @@map("gyms")
}

model GymSport {
  gymId String @map("gym_id") @db.VarChar(64)
  sport String @db.VarChar(20)
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, sport])
  @@map("gym_sports")
}

// userId는 Firebase Auth uid. 복합 PK로 멱등성 확보.
model Favorite {
  userId    String   @map("user_id") @db.VarChar(64)
  gymId     String   @map("gym_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([userId, gymId])
  @@index([userId], map: "idx_favorites_user")
  @@map("favorites")
}

// Firebase Auth uid에 연결되는 앱 전용 프로필/설정.
model UserProfile {
  userId                          String   @id @map("user_id") @db.VarChar(64)
  nickname                        String?  @db.VarChar(30)
  preferredRegion                 String?  @map("preferred_region") @db.VarChar(100)
  preferredSports                 Json     @map("preferred_sports")
  reservationNotificationsEnabled Boolean  @default(true) @map("reservation_notifications_enabled")
  createdAt                       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("user_profiles")
}

// 예약 본체. status: reserved | cancelled | used.
// activeKey는 (userId, gymId, sport, date, time) 인코딩으로 만들어진 중복 방지 키.
model Reservation {
  id        String           @id @db.VarChar(64)
  userId    String           @map("user_id") @db.VarChar(64)
  gymId     String           @map("gym_id") @db.VarChar(64)
  sport     String           @db.VarChar(20)
  date      String           @db.VarChar(10)
  time      String           @db.VarChar(5)
  price     Int
  status    String           @db.VarChar(16)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  activeKey String           @map("active_key") @db.VarChar(255)
  gym       Gym              @relation(fields: [gymId], references: [id])
  lock      ReservationLock?

  @@index([userId, createdAt(sort: Desc)], map: "idx_res_user_created")
  @@map("reservations")
}

// 같은 사용자 같은 슬롯의 활성 예약을 단 1건으로 강제하는 락.
// PK가 activeKey라 INSERT 시 P2002로 중복 감지.
model ReservationLock {
  activeKey     String      @id @map("active_key") @db.VarChar(255)
  reservationId String      @unique @map("reservation_id") @db.VarChar(64)
  status        String      @db.VarChar(16)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_locks")
}

model ReservationSlot {
  gymId         String   @map("gym_id") @db.VarChar(64)
  sport         String   @db.VarChar(20)
  date          String   @db.VarChar(10)
  time          String   @db.VarChar(5)
  capacity      Int
  reservedCount Int      @default(0) @map("reserved_count")
  isClosed      Boolean  @default(false) @map("is_closed")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, sport, date, time])
  @@index([gymId, date], map: "idx_res_slots_gym_date")
  @@map("reservation_slots")
}

// 외부 OAuth provider(카카오/네이버) authorize 요청을 추적하는 단기 store.
// /start에서 익명 uid와 state를 발급해 저장하고, /callback에서 1회 소비한다.
// status: "pending" -> "consumed". 만료된 행은 진입 시 opportunistic cleanup.
model OAuthAttempt {
  attemptId String   @id @map("attempt_id") @db.VarChar(64)
  anonUid   String   @map("anon_uid") @db.VarChar(64)
  provider  String   @db.VarChar(16)
  state     String   @db.VarChar(128)
  status    String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)

  @@index([expiresAt], map: "idx_oauth_attempt_expires")
  @@map("oauth_attempts")
}

// /callback 이후 클라이언트 handover 흐름을 control하는 1회용 ticket.
// 상태 머신: "pending" -> "token_issued" -> "signed_in" -> "transferred".
//   pending      : callback 완료, customToken 미발급
//   token_issued : /token이 nonce 검증 후 customToken 발급
//   signed_in    : 클라이언트가 targetUid ID token으로 /finalize에 도달
//   transferred  : finalize transaction 완료(migration 또는 기존 계정 로그인)
// handoverNonce는 HttpOnly cookie와 1:1 매칭되는 bearer 보강 값이다.
// 신규/기존 판정(needsTransfer, confirmRequired)은 ticket에 저장하지 않는다.
// /finalize transaction 안에서 targetUid의 실제 앱 데이터 상태로 결정한다.
// profilePayload는 callback이 받아온 provider profile snapshot이며,
// finalize 성공 후 admin.updateUser에 사용된다. 토큰류는 저장하지 않는다.
// outcome은 finalize 성공 시 결정된 분기 결과("migrated" | "linked")로,
// 동일 ticket 재호출(idempotent) 시 정확한 transferred bool 응답에 사용된다.
// finalizeAttemptCount/lastFinalizeError는 운영/디버깅용.
// 만료된 행은 진입 시 opportunistic cleanup.
model AuthHandoverTicket {
  ticketId             String   @id @map("ticket_id") @db.VarChar(64)
  anonUid              String   @map("anon_uid") @db.VarChar(64)
  targetUid            String   @map("target_uid") @db.VarChar(64)
  provider             String   @db.VarChar(16)
  handoverNonce        String   @map("handover_nonce") @db.VarChar(128)
  profilePayload       Json?    @map("profile_payload")
  status               String   @db.VarChar(16)
  outcome              String?  @db.VarChar(16)
  finalizeAttemptCount Int      @default(0) @map("finalize_attempt_count")
  lastFinalizeError    String?  @map("last_finalize_error") @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt            DateTime @map("expires_at") @db.DateTime(3)

  @@index([expiresAt], map: "idx_auth_ticket_expires")
  @@map("auth_handover_tickets")
}
