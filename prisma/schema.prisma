// Prisma 스키마 — MySQL 전환 1단계: gyms 조회만 대상.
// 예약/즐겨찾기 테이블은 다음 단계에서 추가한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 가변 길이 배열/객체 필드는 JSON 컬럼으로 둔다.
// sports만 검색/필터에 자주 쓰이므로 별도 테이블로 정규화한다.
model Gym {
  id             String     @id @db.VarChar(64)
  name           String     @db.VarChar(200)
  region         String     @db.VarChar(100)
  address        String     @db.VarChar(300)
  officialUrl    String     @map("official_url") @db.VarChar(500)
  openHours      String     @map("open_hours") @db.VarChar(100)
  basePrice      Int        @map("base_price")
  description    String     @db.Text
  distanceKm     Decimal    @map("distance_km") @db.Decimal(5, 2)
  sportPrices    Json       @map("sport_prices")
  facilities     Json
  availableTimes Json          @map("available_times")
  closedDays     Json          @map("closed_days")
  sports         GymSport[]
  favorites      Favorite[]
  reservations   Reservation[]

  @@map("gyms")
}

model GymSport {
  gymId String @map("gym_id") @db.VarChar(64)
  sport String @db.VarChar(20)
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, sport])
  @@map("gym_sports")
}

// userId는 Firebase Auth uid. 복합 PK로 멱등성 확보.
model Favorite {
  userId    String   @map("user_id") @db.VarChar(64)
  gymId     String   @map("gym_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([userId, gymId])
  @@index([userId], map: "idx_favorites_user")
  @@map("favorites")
}

// 예약 본체. status: reserved | cancelled | used.
// activeKey는 (userId, gymId, sport, date, time) 인코딩으로 만들어진 중복 방지 키.
model Reservation {
  id        String           @id @db.VarChar(64)
  userId    String           @map("user_id") @db.VarChar(64)
  gymId     String           @map("gym_id") @db.VarChar(64)
  sport     String           @db.VarChar(20)
  date      String           @db.VarChar(10)
  time      String           @db.VarChar(5)
  price     Int
  status    String           @db.VarChar(16)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  activeKey String           @map("active_key") @db.VarChar(255)
  gym       Gym              @relation(fields: [gymId], references: [id])
  lock      ReservationLock?

  @@index([userId, createdAt(sort: Desc)], map: "idx_res_user_created")
  @@map("reservations")
}

// 같은 사용자 같은 슬롯의 활성 예약을 단 1건으로 강제하는 락.
// PK가 activeKey라 INSERT 시 P2002로 중복 감지.
model ReservationLock {
  activeKey     String      @id @map("active_key") @db.VarChar(255)
  reservationId String      @unique @map("reservation_id") @db.VarChar(64)
  status        String      @db.VarChar(16)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_locks")
}
