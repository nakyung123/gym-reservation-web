{
  "name": "gym-reservation-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-admin-env.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:prod": "dotenv -v PRISMA_ENV=production -- prisma migrate deploy",
    "db:seed:prod": "dotenv -v PRISMA_ENV=production -- node prisma/seed.mjs",
    "db:seed:demo": "dotenv -e .env.local -- node prisma/seed-demo-reservations.mjs",
    "db:seed:demo:prod": "dotenv -v PRISMA_ENV=production -- node prisma/seed-demo-reservations.mjs",
    "test": "dotenv -e .env.test.local -v PRISMA_ENV=test -- vitest run",
    "test:watch": "dotenv -e .env.test.local -v PRISMA_ENV=test -- vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "db:test:migrate": "dotenv -e .env.test.local -v PRISMA_ENV=test -- prisma migrate deploy",
    "admin:grant-claim": "dotenv -e .env.local -- node scripts/grant-admin-claim.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.108.1",
    "firebase": "^12.12.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "firebase-admin": "^13.8.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
